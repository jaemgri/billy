<div class="chat-index-page">
  <div class="chat-index-hero">
    <div class="chat-hero-icon">
      <%= image_tag "Billy3.png", alt: "Icon", class: "chat-hero-img" %>
    </div>
    <div>
      <h2>Ask Billy</h2>
      <p>Your AI bill assistant — ask anything about your bills</p>
    </div>
  </div>

  <%= link_to new_chat_path, class: "btn-new-chat" do %>
    <i class="fa-solid fa-plus"></i>
    Start a New Chat
  <% end %>

  <% if @chats.any? %>
    <div class="chat-list">
      <% @chats.each do |chat| %>
        <%= link_to chat_path(chat), class: "chat-card" do %>
          <div class="chat-card-icon">
            <%= image_tag "Billy3.png", alt: "Icon", class: "billy-card-img" %>
          </div>
          <div class="chat-card-body">
            <strong><%= chat.bill&.name || "General chat" %></strong>
            <span><%= chat.created_at.strftime("%b %d, %Y") %></span>
          </div>
          <i class="fa-solid fa-chevron-right chat-card-arrow"></i>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="chat-empty">No chats yet — start one from a bill's page!</p>
  <% end %>
</div>
