<meta name="turbo-cache-control" content="no-cache">

<div class="chat-new-page">
  <div class="chat-index-hero">
    <div class="chat-hero-icon">
      <i class="fa-solid fa-robot"></i>
    </div>
    <div>
      <h2>Start a New Chat</h2>
      <p>Ask about a specific bill, or start a general chat.</p>
    </div>
  </div>

  <%= form_with url: chats_path, method: :post do |f| %>
    <div class="chat-new-form-card">
      <div class="form-group">
        <label class="chat-select-label">Select a Bill</label>
        <div class="chat-select-wrapper">
          <select name="bill_id" class="chat-select">
            <option value="">General chat (no specific bill)</option>
            <% @bills.each do |bill| %>
              <option value="<%= bill.id %>"><%= bill.name %></option>
            <% end %>
          </select>
          <i class="fa-solid fa-chevron-down chat-select-icon"></i>
        </div>
      </div>
    </div>

    <%= f.submit "Start Chat", class: "btn-start-chat" %>
  <% end %>
</div>
