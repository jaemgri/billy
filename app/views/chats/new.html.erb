<div class="chat-page">
  <h2><i class="fa-solid fa-robot"></i> Start a New Chat</h2>
  <p class="text-muted">Which bill do you want to ask Billy about?</p>

  <%= form_with url: chats_path, method: :post do |f| %>
    <div class="mb-3">
      <select name="bill_id" class="form-select">
        <% @bills.each do |bill| %>
          <option value="<%= bill.id %>"><%= bill.name %></option>
        <% end %>
      </select>
    </div>
    <%= f.submit "Start Chat", class: "btn-app-primary" %>
  <% end %>
</div>
