<div class="chat-page">
  <h2><i class="fa-solid fa-robot"></i> Ask Billy</h2>
  <p class="text-muted">About: <%= @chat.bill&.name || "General" %></p>

  <div class="chat-messages">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="chat-bubble <%= message.role %>">
          <%= raw(render_markdown(message.content)) %>
        </div>
      <% end %>
    <% else %>
      <div class="chat-bubble assistant">
        Hi! I'm Billy. Ask me anything about this bill.
      </div>
    <% end %>
  </div>

  <%= form_with url: chat_messages_path(@chat), method: :post, class: "chat-input-bar" do |f| %>
      <%= f.text_field :content, placeholder: "Type your message...", required: true, autocomplete: "off" %>
      <%= f.submit "➤" %>
  <% end %>
</div>
