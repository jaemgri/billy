<nav class="app-header">

  <%= link_to root_path, class: "text-decoration-none" do %>
    <h2 class="header-title">
      <i class="fa-solid fa-robot"></i>
      Billy
    </h2>
  <% end %>


  <div class="header-right">

    <% if user_signed_in? %>

    <%= link_to edit_user_registration_path, class: "user-pill" do %>
      <span class="user-avatar">
        <%= (current_user.name.presence || current_user.email).first.upcase %>
      </span>

    <%= current_user.name.presence || current_user.email.split("@").first %>
  <% end %>


      <%= button_to "Sign Out",
          destroy_user_session_path,
          method: :delete,
          data: { turbo_method: :delete },
          class: "header-signout-btn" %>


    <% elsif !current_page?(new_user_session_path) %>

      <%= link_to "Sign In",
          new_user_session_path,
          class: "header-signin-btn" %>

    <% end %>

  </div>

</nav>
