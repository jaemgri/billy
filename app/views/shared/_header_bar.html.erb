<nav class="app-header">
  <%= link_to root_path, class: "text-decoration-none" do %>
    <h2 class="header-title fs-1 px-2">
      <i class="fa-solid fa-robot"></i>Billy
    </h2>
  <% end %>

  <div class="header-right">
    <% if user_signed_in? %>
      <%= button_to "Sign Out",
          destroy_user_session_path,
          method: :delete,
          class: "header-btn header-btn-outline" %>

    <% elsif !current_page?(new_user_session_path) %>

      <%= link_to "Log In",
          new_user_session_path,
          class: "header-btn" %>

    <% end %>
  </div>
</nav>

</nav>
