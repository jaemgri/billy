<nav class="app-header">
  <div class="header-left">
    <div class="header-avatar">
      <i class="fa-solid fa-user"></i>
    </div>
  </div>


  <%= link_to root_path, class: "text-decoration-none" do %>
    <h2 class="header-title fs-1 px-2"><i class="fa-solid fa-robot"></i>Billy</h2>
  <% end %>

  <div class="header-right">
    <% if user_signed_in? %>
    <%= button_to "Log Out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
      <% else %>
    <%= link_to "Log In", new_user_session_path, class: "btn btn-primary" %>
<% end %>

</nav>
