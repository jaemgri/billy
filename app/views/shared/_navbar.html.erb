<div class="bottom-navbar">

  <%= link_to root_path,
      class: "nav-item #{'active' if current_page?(root_path)}" do %>
    <i class="fa-solid fa-house"></i>
    <span>Home</span>
  <% end %>

  <%= link_to new_bill_path,
      class: "nav-item nav-item-add #{'active' if current_page?(new_bill_path)}" do %>
    <i class="fa-solid fa-plus"></i>
    <span>Add Bill</span>
  <% end %>

  <%= link_to chats_path,
      class: "nav-item #{'active' if current_page?(chats_path)}" do %>
    <span class="robot-icon-wrap">
      <i class="fa-solid fa-bolt bolt bolt-left"></i>
      <i class="fa-solid fa-robot sparkle-btn"></i>
      <i class="fa-solid fa-bolt bolt bolt-right"></i>
    </span>
    <span>Billy</span>
  <% end %>

</div>
