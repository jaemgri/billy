<div class="new-bill-page">

  <div class="bill-header">
    <h1 class="new-bill-title"><%= @bill.name %></h1>
  </div>

  <%# pending-invite banner %>
  <% if @my_shared_bill&.pending? %>
    <div class="new-bill-form-card">
      <h2 class="section-title">You've been invited to this bill</h2>
      <p class="bill-value">
        <%= @bill.user.email %> shared this bill with you.
        <% if @my_shared_bill.split_amount.present? %>
          Your share: ¥<%= @my_shared_bill.split_amount.to_i %>
        <% end %>
      </p>
      <div class="action-buttons">
        <%= button_to "Accept", accept_bill_shared_bill_path(@bill, @my_shared_bill), method: :patch, class: "action-btn" %>
        <%= button_to "Ignore", leave_bill_shared_bill_path(@bill, @my_shared_bill), method: :delete, class: "action-btn delete", data: { turbo_confirm: "Ignore this invite?" } %>
      </div>
    </div>
  <% end %>

  <%# wrap in unless pending %>
  <% unless @my_shared_bill&.pending? %>

  <div class="new-bill-form-card">
    <div class="form-group">
      <label>Description</label>
      <p class="bill-value">
        <%= @bill.description.presence || "No description" %>
      </p>
    </div>
    <div class="form-group">
      <label>Amount</label>
      <h2 class="bill-amount">¥<%= @bill.amount.to_i%></h2>
    </div>
    <div class="form-group">
      <label>Category</label>
      <p class="bill-value"><%= @bill.category %></p>
    </div>
    <div class="form-group">
      <label>Due Date</label>
      <p class="bill-value">
        <%= @bill.due_date.strftime("%B %d, %Y") %>
      </p>
    </div>

  </div>

  <%# Ask Billy now gated to owner or accepted shared user %>
  <% if @bill.user == current_user || @my_shared_bill&.accepted? %>
    <%= button_to "💬 Ask Billy",
        chats_path(bill_id: @bill.id),
        method: :post,
        class: "btn-submit-bill" %>
  <% end %>

  <div class="action-buttons">

    <%# Edit now gated to owner or accepted shared user %>
    <% if @bill.user == current_user || @my_shared_bill&.accepted? %>
      <%= link_to edit_bill_path(@bill), class: "action-btn" do %>
        <i class="fa-solid fa-pen"></i>
        <span>Edit</span>
      <% end %>
    <% end %>

    <%= link_to bills_path, class: "action-btn" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back</span>
    <% end %>

    <%# Delete is now owner-only; shared users get to Leave instead (was unconditional Delete for everyone) %>
    <% if @bill.user == current_user %>
      <%= link_to bill_path(@bill),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure?"
          },
          class: "action-btn delete" do %>
        <i class="fa-solid fa-trash"></i>
        <span>Delete</span>
      <% end %>
    <% elsif @my_shared_bill&.accepted? %>
      <%= button_to leave_bill_shared_bill_path(@bill, @my_shared_bill),
          method: :delete,
          class: "action-btn delete",
          data: { turbo_confirm: "Leave this bill?"} do %>
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Leave</span>
      <% end %>
    <% end %>
  </div>

 <% if @bill.user == current_user %>

    <div class="new-bill-form-card">

      <h2 class="section-title">Share Bill</h2>

      <%= form_with model: [@bill, SharedBill.new] do |f| %>

        <div class="form-group">
          <%= f.label :invited_email, "Email" %>
          <%= f.email_field :invited_email,
                placeholder: "person@example.com",
                class: "form-input",
                required: true %>
        </div>

        <%= f.submit "Share", class: "btn-submit-bill mt-3" %>

      <% end %>

    </div>

    <div class="new-bill-form-card">

      <h2 class="section-title">Shared With</h2>

      <p class="bill-value">
        Assigned to others: ¥<%= @bill.shared_bills.sum(:split_amount).to_i %>
        - Your remaining share: ¥<%= @bill.owner_remaining_amount.to_i %>
      </p>
      <% if @bill.shared_bills.any? %>

        <% @bill.shared_bills.each do |sb| %>

          <div class="shared-user">

            <div>
              <strong><%= sb.user&.email || sb.invited_email %></strong><br>
              <small><%= "Pending invitation" unless sb.user %>
                <%# show invite status next to pending %>
                <br>
                <%= sb.status %>
              </small>
            </div>

            <%# Owner sets/updates this person's split amount & sees paid status %>
            <%= form_with model: [@bill, sb], method: :patch, html: { class: "split-form" } do |f| %>
              <%= f.number_field :split_amount, step: 0.01, value: sb.split_amount, placeholder: "Split ¥", class: "form-input" %>
              <%= f.submit "Set", class: "action-btn" %>
            <% end %>
            <span class="bill-value"><%= sb.paid? ? "Paid" : "Unpaid" %></span>


            <%= button_to "",
                  [@bill, sb],
                  method: :delete,
                  class: "remove-btn fa-solid fa-xmark",
                  data: { turbo_confirm: "Remove access?" } %>

          </div>

        <% end %>

      <% else %>

        <p class="bill-value">This bill hasn't been shared yet.</p>

      <% end %>

    </div>

  <% end %>

  <%# A shared user sees their own split & can mark it paid %>
  <% if @my_shared_bill&.accepted? && @my_shared_bill.split_amount.present? %>
    <div class="new-bill-form-card">
      <h2 class="section-title">Your Share</h2>
      <p class="bill-value">¥<%= @my_shared_bill.split_amount.to_i %> — <%= @my_shared_bill.paid? ? "Paid" : "Unpaid" %></p>
      <% unless @my_shared_bill.paid? %>
        <%= button_to "Mark as paid", mark_paid_bill_shared_bill_path(@bill, @my_shared_bill), method: :patch, class: "btn-submit-bill" %>
      <% end %>
    </div>
  <% end %>

  <% end %>

</div>
