<%= form_with model: bill, id: "new-bill-form" do |f| %>
    <div class="new-bill-form-card">
      <div class="form-group">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-input", data: { "bill-upload-target": "nameField" } %>
      </div>

      <div class="form-group">
        <%= f.label :description %>
        <%= f.text_area :description, class: "form-input", data: { "bill-upload-target": "descriptionField" } %>
      </div>
      

      <div class="form-group">
        <%= f.label :amount %>
        <%= f.number_field :amount, class: "form-input", data: { "bill-upload-target": "amountField" } %>
      </div>

      <div class="form-group">
        <%= f.label :category %>
        <%= f.select :category, Bill.categories.keys.map(&:capitalize), {}, class: "form-input", data: { "bill-upload-target": "categoryField" } %>
      </div>

      <div class="form-group">
        <%= f.label :due_date %>
        <%= f.date_field :due_date, class: "form-input", data: { "bill-upload-target": "dueDateField" } %>
      </div>

      <div class="form-group-toggle">
        <div>
          <span class="toggle-label">Paid</span>
          <span class="toggle-sublabel">Mark this bill as paid</span>
        </div>
        <label class="toggle-switch">
          <%= f.check_box :paid, class: "toggle-input" %>
          <span class="toggle-track"></span>
        </label>
      </div>
    </div>

    <% if use_image %>
      <input type="file" accept="image/*" class="d-none"
            data-bill-upload-target="fileInput"
            data-action="change->bill-upload#upload">

      <button type="button" class="btn-upload-bill"
        data-bill-upload-target="button"
        data-action="click->bill-upload#trigger">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
          Magic Upload<br>
        <span>Snap a bill and Billy will fill in the details.</span>
      </button>
    <% end %>

    <div class="form-actions mt-3">
      <%= link_to "Return", :back, class: "btn-return-bill" %>
      <%= f.submit "Submit", class: "btn-submit-bill" %>
    </div>
  <% end %>
