<div class="d-flex justify-content-center m-3">
  <h2>Bills in category: <%= @category %></h2>
</div>

<% if @bills.any? %>
  <% @bills.each do |bill| %>
    <%= link_to bill_path(bill), { class: "text-decoration-none" } do %>
      <div class="bill-card mb-2 p-3 border rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center w-100">
          <div>
            <div class="d-flex align-items-center">
              <span class="bill-name fw-bold"><%= bill.name %></span>
              <span class="badge bg-secondary ms-2"><%= bill.category %></span>
            </div>
            <div class="text-muted small">
              Due <%= bill.due_date.strftime("%b %d") %>
            </div>
          </div>
          <div class="fw-bold fs-5">
            ¥<%= bill.amount_for(current_user).to_i %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p class="text-muted fst-italic text-center">No bills in this category.</p>
<% end %>
