<div class="container py-1">

  <div class="row g-2">

    <div class="dashboard-summary">
      <div>
        <h2>Hello👋</h2>
        <p>You have <strong><%= @due_this_month.count %></strong> bill(s) due this month.</p>
      </div>
    </div>

    <!-- Pending Invites -->
    <% pending_invites = current_user.shared_bills.pending %>
    <% if pending_invites.any? %>
      <div class="col-12">
        <div class="dashboard-card">
          <div class="dashboard-header">
            <h3>📨 Pending Invites</h3>
            <span><%= pending_invites.count %> Invite(s)</span>
          </div>

          <% pending_invites.each do |sb| %>
            <div class="dashboard-bill-card">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="bill-name"><%= sb.bill.name %></span>
                  </div>
                  <small>from <%= sb.bill.user.email %></small>
                </div>

                <div class="d-flex gap-2">
                  <%= button_to "Accept", accept_bill_shared_bill_path(sb.bill, sb), method: :patch, class: "action-btn" %>
                  <%= button_to "Ignore", leave_bill_shared_bill_path(sb.bill, sb), method: :delete, class: "action-btn delete", data: { turbo_confirm: "Ignore this invite?" } %>
                </div>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- Calendar -->
    <div class="col-12 col-lg-8">
      <div class="calendar-card">

        <%= month_calendar(events: @bills, attribute: :due_date) do |date, bills| %>

          <%= link_to "/bills/date/#{date}", class: "calendar-day text-decoration-none" do %>

            <div class="day-number"><%= date.day %></div>

          <% bills.first(2).each do |bill| %>
            <div class="calendar-bill <%= bill.paid ? 'paid' : 'unpaid' %>">
              <%= bill.name %>
            </div>
          <% end %>

          <% if bills.size > 2 %>
            <div class="calendar-more">
              +<%= bills.size - 2 %> more
            </div>
          <% end %>

          <% end %>

        <% end %>

      </div>
    </div>

    <!-- Bills -->
    <div class="col-12 col-lg-4">

      <div class="dashboard-card">

        <div class="dashboard-header">
          <h3>💸 Due This Month</h3>
          <span><%= @due_this_month.count %> Bill(s)</span>
        </div>

        <% if @due_this_month.any? %>

          <% @due_this_month.each do |bill| %>

            <%= link_to bill_path(bill), class: "text-decoration-none" do %>

              <div class="dashboard-bill-card">

                <div class="d-flex justify-content-between align-items-center">

                  <div>

                    <div class="d-flex align-items-center gap-2">

                      <span class="bill-name">
                        <%= bill.name %>
                      </span>

                      <span class="category-pill">
                        <%= bill.category %>
                      </span>

                    </div>

                    <small>
                      Due <%= bill.due_date.strftime("%b %d") %>
                    </small>

                  </div>

                  <div class="bill-price">
                    <%= number_to_currency(bill.amount.to_i, unit: "¥", precision: 0) %>
                  </div>

                </div>

              </div>

            <% end %>

          <% end %>

        <% else %>

          <div class="empty-state">
            🎉 No bills due this month!
          </div>

        <% end %>

        <div class="dashboard-total">

          <span>Total Due</span>

          <strong>
            <%= number_to_currency(@due_this_month.sum(&:amount), unit: "¥", precision: 0) %>
          </strong>

        </div>

      </div>

    </div>

  </div>

</div>
