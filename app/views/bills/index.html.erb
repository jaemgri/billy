<div class="container py-1">

  <div class="row g-2">

    <div class="dashboard-summary">
      <div>
        <h2>Hello, <%= current_user.username %>👋</h2>
        <p>You have <strong><%= @due_this_month.count %></strong> bill(s) due this month.</p>
      </div>
    </div>

    <!-- Pending Invites -->
    <% pending_invites = current_user.shared_bills.pending %>
    <% if pending_invites.any? %>
      <div class="col-12">
        <div class="dashboard-card">
          <div class="dashboard-header">
            <h3>📨 Pending Invites</h3>
            <span><%= pending_invites.count %> Invite(s)</span>
          </div>

          <% pending_invites.each do |sb| %>
            <div class="dashboard-bill-card">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="bill-name"><%= sb.bill.name %></span>
                  </div>
                  <small>from <%= sb.bill.user.email %></small>
                </div>

                <div class="d-flex gap-2">
                  <%= button_to "Accept", accept_bill_shared_bill_path(sb.bill, sb), method: :patch, class: "action-btn" %>
                  <%= button_to "Ignore", leave_bill_shared_bill_path(sb.bill, sb), method: :delete, class: "action-btn delete", data: { turbo_confirm: "Ignore this invite?" } %>
                </div>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- Calendar -->
    <div class="col-12 col-lg-8">
      <div class="calendar-card">

        <%= month_calendar(events: @bills, attribute: :due_date) do |date, bills| %>
          <%= link_to "/bills/date/#{date}", class: "calendar-day text-decoration-none" do %>

            <div class="day-number"><%= date.day %></div>

            <div class="bill-list">
              <% if bills.any? %>
                <div class="calendar-badge">
                  <%= bills.size %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>

        </div>
      </div>

    <!-- Bills -->
    <div class="col-12 col-lg-4">

      <div class="dashboard-card">

        <div class="dashboard-header">
          <h3>💸 Due This Month</h3>
          <span><%= @due_this_month.count %> Bill(s)</span>
        </div>

        <% if @due_this_month.any? %>

          <% @due_this_month.each do |bill| %>

            <div class="dashboard-bill-card">

              <!-- Clickable details row -->
              <%= link_to bill_path(bill), class: "text-decoration-none text-reset" do %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <div>
                    <div class="d-flex align-items-center gap-2">
                      <span class="bill-name">
                        <%= bill.name %>
                      </span>
                      <span class="category-pill">
                        <%= bill.category %>
                      </span>
                    </div>
                    <small>
                      Due <%= bill.due_date.strftime("%b %d") %>
                    </small>
                  </div>

                  <div class="bill-price">
                    <%= number_to_currency(bill.amount_for(current_user).to_i, unit: "¥", precision: 0) %>
                  </div>
                </div>
              <% end %>

              <!-- Toggle form kept separate from the link -->
              <%= form_with model: bill, id: "edit_bill_#{bill.id}" do |f| %>
                <div class="form-group-toggle">
                  <div>
                    <span class="toggle-label">Paid</span>
                    <span class="toggle-sublabel">Mark this bill as paid</span>
                  </div>
                  <label class="toggle-switch">
                    <%= f.check_box :paid, class: "toggle-input", onchange: "this.form.requestSubmit()" %>
                    <span class="toggle-track"></span>
                  </label>
                </div>
              <% end %>

            </div>

          <% end %>

        <% else %>

          <div class="empty-state">
            🎉 No bills due this month!
          </div>

        <% end %>

        <div class="dashboard-total">

          <span>Total Due</span>
          <strong>
            <%= number_to_currency(@due_this_month.sum { |bill| bill.amount_for(current_user) }, unit: "¥", precision: 0) %>
          </strong>

        </div>

      </div>

    </div>

  </div>

</div>
