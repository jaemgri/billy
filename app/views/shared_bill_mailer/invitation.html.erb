<h1>You've been invited to view a bill on Billy!</h1>

<p><%= @bill.user.email %> shared a bill with you.</p>

<div style="background: #f7fafc; border-radius: 12px; padding: 16px; margin: 20px 0;">
  <h2 style="margin: 0 0 8px;"><%= @bill.name %></h2>
  <p style="margin: 0;">Amount: ¥<%= @bill.amount %></p>
  <p style="margin: 0;">Due: <%= @bill.due_date %></p>
  <p style="margin: 0;">Category: <%= @bill.category %></p>
</div>

<p>
  <%= link_to "View this bill on Billy", bill_url(@bill) %>
</p>
